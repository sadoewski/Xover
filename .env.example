# PostgreSQL Configuration
POSTGRES_DB=hostprint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_in_production_use_strong_password_here

# Backend Configuration
NODE_ENV=production
PORT=5000

# Database Connection
DB_HOST=db
DB_PORT=5432
DB_NAME=hostprint
DB_USER=postgres
DB_PASSWORD=change_this_in_production_use_strong_password_here

# JWT Configuration
JWT_SECRET=change_this_to_random_64_character_string_in_production
JWT_EXPIRES_IN=7d

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
