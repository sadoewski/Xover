# CI Environment Variables
# This file is used in GitHub Actions CI pipeline

NODE_ENV=test

# Database (provided by postgres service in CI)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hostprint_test
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=test-jwt-secret-for-ci-only

# Server
PORT=5001

# Morphology (optional in tests)
MORPHOLOGY_ENABLED=true
